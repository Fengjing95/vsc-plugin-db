{
  "name": "vscode-db-explorer",
  "private": true,
  "version": "0.10.1",
  "description": "数据库浏览器 VSCode 插件 — 统一的、可插拔的数据库访问入口",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @db-explorer/webview-ui build && pnpm --filter db-kit build",
    "watch": "pnpm --filter db-kit watch",
    "typecheck": "pnpm -r --stream run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "pnpm build && pnpm --filter db-kit-e2e build && pnpm --filter db-kit-e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
