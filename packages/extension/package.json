{
  "name": "db-kit",
  "displayName": "DB Kit",
  "galleryBanner": {
    "color": "#1554c0",
    "theme": "dark"
  },
  "description": "在 VSCode 内浏览、查询、编辑 MySQL / PostgreSQL / Redis / SQLite / MongoDB：资源树、表格视图、SQL Console、结构管理与流式导出。",
  "version": "0.1.1",
  "publisher": "db-explorer-dev",
  "license": "Apache-2.0",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fengjing95/vsc-plugin-db.git"
  },
  "keywords": [
    "database",
    "mysql",
    "postgresql",
    "redis",
    "sqlite",
    "mongodb",
    "sql"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbExplorer-container",
          "title": "数据库",
          "icon": "media/database.svg"
        }
      ],
      "panel": [
        {
          "id": "dbExplorer-console-result",
          "title": "SQL 结果",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbExplorer-container": [
        {
          "id": "dbExplorer.connections",
          "name": "连接",
          "type": "tree"
        }
      ],
      "dbExplorer-console-result": [
        {
          "id": "dbExplorer.consoleResult",
          "name": "SQL 结果",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dbExplorer.focus",
        "title": "聚焦数据库视图",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.newConnection",
        "title": "新建连接",
        "category": "数据库",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editConnection",
        "title": "编辑连接",
        "category": "数据库",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.copyConnection",
        "title": "复制连接",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.deleteConnection",
        "title": "删除连接",
        "category": "数据库",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.refresh",
        "title": "刷新",
        "category": "数据库",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.refreshNode",
        "title": "刷新",
        "category": "数据库",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.viewDdl",
        "title": "查看 DDL",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.createDatabase",
        "title": "新建库",
        "icon": "$(add)",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.alterDatabase",
        "title": "编辑库",
        "icon": "$(edit)",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.dropDatabase",
        "title": "删除库",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.createTable",
        "title": "新建表",
        "category": "数据库",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.alterTable",
        "title": "修改表结构",
        "category": "数据库",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.dropTable",
        "title": "删除表",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.generateCode",
        "title": "由表结构生成代码",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.copyName",
        "title": "复制名称",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.addColumn",
        "title": "新增列",
        "category": "数据库",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editColumn",
        "title": "编辑列",
        "category": "数据库",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.dropColumn",
        "title": "删除列",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.copyQualifiedName",
        "title": "复制全限定名 (库.表.列)",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.generateSelect",
        "title": "生成 SELECT",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.openTable",
        "title": "打开表格视图",
        "category": "数据库",
        "icon": "$(link-external)"
      },
      {
        "command": "dbExplorer.queries.create",
        "title": "新增查询",
        "category": "数据库",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.queries.openDir",
        "title": "打开查询目录",
        "category": "数据库",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dbExplorer.queries.delete",
        "title": "删除查询",
        "category": "数据库",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.queries.rename",
        "title": "重命名查询",
        "category": "数据库",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.queries.open",
        "title": "打开查询",
        "category": "数据库",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dbExplorer.executeQuery",
        "title": "执行 SQL",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.executeQueryAt",
        "title": "执行语句（CodeLens 入口）",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.executeQueryAll",
        "title": "执行全部语句",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.consoleSelectConnection",
        "title": "SQL Console：选择连接/数据库",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.queryHistory",
        "title": "SQL 执行历史",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.disconnectConnection",
        "title": "断开连接",
        "category": "数据库",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dbExplorer.saveQuery",
        "title": "保存查询",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.openSavedQuery",
        "title": "打开保存的查询",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.formatSql",
        "title": "格式化 SQL",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.showLog",
        "title": "打开日志",
        "category": "数据库"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dbExplorer.saveQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.formatSql",
          "when": "editorLangId == sql"
        }
      ],
      "view/title": [
        {
          "command": "dbExplorer.newConnection",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.refresh",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbExplorer.openTable",
          "when": "viewItem =~ /^(table|view|collection)( ddl)?$/",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.openTable",
          "when": "viewItem =~ /^(table|view|collection)( ddl)?$/",
          "group": "1_open@0"
        },
        {
          "command": "dbExplorer.queries.create",
          "when": "viewItem =~ /^queries$/",
          "group": "2_object@6"
        },
        {
          "command": "dbExplorer.queries.create",
          "when": "viewItem =~ /^queries$/",
          "group": "inline@0"
        },
        {
          "command": "dbExplorer.queries.openDir",
          "when": "viewItem =~ /^queries$/",
          "group": "2_object@7"
        },
        {
          "command": "dbExplorer.queries.openDir",
          "when": "viewItem =~ /^queries$/",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.queries.rename",
          "when": "viewItem =~ /^query$/",
          "group": "2_object@0"
        },
        {
          "command": "dbExplorer.queries.delete",
          "when": "viewItem =~ /^query$/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.queries.delete",
          "when": "viewItem =~ /^query$/",
          "group": "inline@0"
        },
        {
          "command": "dbExplorer.copyConnection",
          "when": "viewItem =~ /^connection/",
          "group": "9_cutcopypaste"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "viewItem =~ /^connection/",
          "group": "3_manage@0"
        },
        {
          "command": "dbExplorer.deleteConnection",
          "when": "viewItem =~ /^connection/",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.disconnectConnection",
          "when": "viewItem =~ /^connection connected/",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.refreshNode",
          "when": "viewItem =~ /^connection connected/ || viewItem =~ /^database( ddl)?( dbddl(-alter)?)?$/",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.viewDdl",
          "when": "viewItem =~ /^(table|view)( ddl)?$/",
          "group": "2_object@1"
        },
        {
          "command": "dbExplorer.alterTable",
          "when": "viewItem =~ /^table ddl$/",
          "group": "2_object@5"
        },
        {
          "command": "dbExplorer.dropTable",
          "when": "viewItem =~ /^table ddl$/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.createDatabase",
          "when": "viewItem =~ /^connection connected dbddl$/",
          "group": "2_object@4"
        },
        {
          "command": "dbExplorer.alterDatabase",
          "when": "viewItem =~ /^database( ddl)?( dbddl)? dbddl-alter$/",
          "group": "2_object@4"
        },
        {
          "command": "dbExplorer.dropDatabase",
          "when": "viewItem =~ /^database( ddl)? dbddl/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.createTable",
          "when": "viewItem =~ /^database ddl( dbddl(-alter)?)?$/ || viewItem =~ /^folder-table ddl$/",
          "group": "2_object@5"
        },
        {
          "command": "dbExplorer.generateCode",
          "when": "viewItem =~ /^(table|view)( ddl)?$/",
          "group": "2_object@4"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "viewItem =~ /^(table|view)( ddl)?$/ || viewItem == collection || viewItem == column || viewItem == index || viewItem == key",
          "group": "2_object@2"
        },
        {
          "command": "dbExplorer.generateSelect",
          "when": "viewItem =~ /^(table|view)( ddl)?$/",
          "group": "2_object@3"
        },
        {
          "command": "dbExplorer.addColumn",
          "when": "viewItem =~ /^folder-columns ddl$/ || viewItem =~ /^column ddl$/",
          "group": "2_object@5"
        },
        {
          "command": "dbExplorer.editColumn",
          "when": "viewItem =~ /^column ddl$/",
          "group": "2_object@6"
        },
        {
          "command": "dbExplorer.dropColumn",
          "when": "viewItem =~ /^column ddl$/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.copyQualifiedName",
          "when": "viewItem =~ /^column( ddl)?$/",
          "group": "2_object@1"
        },
        {
          "command": "dbExplorer.refreshNode",
          "when": "viewItem =~ /^connection connected/",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.disconnectConnection",
          "when": "viewItem =~ /^connection connected/",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbExplorer.focus",
        "key": "ctrl+alt+d"
      },
      {
        "command": "dbExplorer.queryHistory",
        "key": "ctrl+alt+h"
      },
      {
        "command": "dbExplorer.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "dbExplorer.executeQueryAll",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "DB Explorer",
      "properties": {
        "dbExplorer.query.maxRows": {
          "type": "number",
          "default": 1000,
          "description": "单次查询/表格取数行数上限"
        },
        "dbExplorer.query.timeoutMs": {
          "type": "number",
          "default": 15000,
          "description": "驱动调用默认超时（毫秒）"
        },
        "dbExplorer.connection.connectTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "建连超时（毫秒，含 SSH 隧道建立）"
        },
        "dbExplorer.export.chunkRows": {
          "type": "number",
          "default": 1000,
          "description": "导出分页批量（行）"
        },
        "dbExplorer.export.defaultFormat": {
          "type": "string",
          "default": "csv",
          "enum": [
            "csv",
            "json",
            "xlsx"
          ],
          "description": "导出默认格式"
        },
        "dbExplorer.queries.directory": {
          "type": "string",
          "default": "",
          "description": "查询文件存储目录（树「查询」目录与保存查询；留空用扩展全局存储，不与工作区绑定；支持 ~/ 前缀，如 ~/Documents/db-queries）"
        },
        "dbExplorer.transaction.idleTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "交互式事务空闲超时（毫秒，超时自动 ROLLBACK，D-09/§4.6，默认 5 分钟）"
        },
        "dbExplorer.edit.allowNoPrimaryKey": {
          "type": "boolean",
          "default": false,
          "description": "无主键表开启\"全列匹配\"编辑模式（WHERE 含全部列原值，含二进制列的表仍不可编辑，D-03）"
        }
      }
    }
  },
  "dependencies": {
    "@db-explorer/core": "workspace:*",
    "@db-explorer/driver-mock": "workspace:*",
    "@db-explorer/driver-mongo": "workspace:*",
    "@db-explorer/driver-mysql": "workspace:*",
    "@db-explorer/driver-postgres": "workspace:*",
    "@db-explorer/driver-redis": "workspace:*",
    "@db-explorer/driver-sqlite": "workspace:*",
    "@db-explorer/protocol": "workspace:*",
    "exceljs": "^4.4.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0"
  }
}
