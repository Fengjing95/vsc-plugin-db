{
  "name": "db-explorer",
  "displayName": "数据库浏览器 DB Explorer",
  "description": "在 VSCode 内浏览、查询、编辑数据库。M0：资源树 + 表格视图 RPC 演示。",
  "version": "0.1.0",
  "private": true,
  "publisher": "db-explorer-dev",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbExplorer-container",
          "title": "数据库",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbExplorer-container": [
        {
          "id": "dbExplorer.connections",
          "name": "连接",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "dbExplorer.focus",
        "title": "聚焦数据库视图",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.newConnection",
        "title": "新建连接",
        "category": "数据库",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editConnection",
        "title": "编辑连接",
        "category": "数据库",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.copyConnection",
        "title": "复制连接",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.deleteConnection",
        "title": "删除连接",
        "category": "数据库",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.refresh",
        "title": "刷新",
        "category": "数据库",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.refreshNode",
        "title": "刷新",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.viewDdl",
        "title": "查看 DDL",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.copyName",
        "title": "复制名称",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.copyQualifiedName",
        "title": "复制全限定名 (库.表.列)",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.generateSelect",
        "title": "生成 SELECT",
        "category": "数据库"
      },
      {
        "command": "dbExplorer.openTable",
        "title": "打开表格视图",
        "category": "数据库",
        "icon": "$(table)"
      },
      {
        "command": "dbExplorer.newQuery",
        "title": "新建 SQL Console",
        "category": "数据库"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "dbExplorer.newConnection", "group": "navigation@1" },
        { "command": "dbExplorer.refresh", "group": "navigation@2" }
      ],
      "view/item/context": [
        {
          "command": "dbExplorer.openTable",
          "when": "viewItem == table || viewItem == view",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.deleteConnection",
          "when": "viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "dbExplorer.copyConnection",
          "when": "viewItem == connection",
          "group": "9_cutcopypaste"
        },
        {
          "command": "dbExplorer.refreshNode",
          "when": "viewItem == connection || viewItem == database",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.viewDdl",
          "when": "viewItem == table || viewItem == view",
          "group": "2_object@1"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "viewItem == table || viewItem == view || viewItem == column || viewItem == index || viewItem == key",
          "group": "2_object@2"
        },
        {
          "command": "dbExplorer.generateSelect",
          "when": "viewItem == table || viewItem == view",
          "group": "2_object@3"
        },
        {
          "command": "dbExplorer.copyQualifiedName",
          "when": "viewItem == column",
          "group": "2_object@1"
        }
      ]
    },
    "keybindings": [
      { "command": "dbExplorer.focus", "key": "ctrl+alt+d" },
      { "command": "dbExplorer.newQuery", "key": "ctrl+alt+q" }
    ],
    "configuration": {
      "title": "DB Explorer",
      "properties": {
        "dbExplorer.query.maxRows": {
          "type": "number",
          "default": 1000,
          "description": "单次查询/表格取数行数上限"
        },
        "dbExplorer.query.timeoutMs": {
          "type": "number",
          "default": 15000,
          "description": "驱动调用默认超时（毫秒）"
        },
        "dbExplorer.export.chunkRows": {
          "type": "number",
          "default": 1000,
          "description": "导出分页批量（行）"
        },
        "dbExplorer.export.defaultFormat": {
          "type": "string",
          "default": "csv",
          "enum": ["csv", "json"],
          "description": "导出默认格式"
        }
      }
    }
  },
  "dependencies": {
    "@db-explorer/core": "workspace:*",
    "@db-explorer/driver-mock": "workspace:*",
    "@db-explorer/driver-mysql": "workspace:*",
    "@db-explorer/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0"
  }
}
