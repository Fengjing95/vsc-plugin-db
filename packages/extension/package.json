{
  "name": "db-kit",
  "displayName": "DB Kit",
  "galleryBanner": {
    "color": "#1554c0",
    "theme": "dark"
  },
  "description": "在 VSCode 内浏览、查询、编辑 MySQL / PostgreSQL / Redis / SQLite / MongoDB：资源树、表格视图、SQL Console、结构管理与流式导出。",
  "version": "0.9.0",
  "publisher": "db-explorer-dev",
  "license": "Apache-2.0",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fengjing95/vsc-plugin-db.git"
  },
  "keywords": [
    "database",
    "mysql",
    "postgresql",
    "redis",
    "sqlite",
    "mongodb",
    "sql"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbExplorer-container",
          "title": "%viewsContainers.activitybar.title%",
          "icon": "media/database.svg"
        }
      ],
      "panel": [
        {
          "id": "dbExplorer-console-result",
          "title": "%viewsContainers.panel.title%",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbExplorer-container": [
        {
          "id": "dbExplorer.connections",
          "name": "%views.connections.name%",
          "type": "tree"
        }
      ],
      "dbExplorer-console-result": [
        {
          "id": "dbExplorer.consoleResult",
          "name": "%views.consoleResult.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dbExplorer.focus",
        "title": "%command.dbExplorer.focus.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.newConnection",
        "title": "%command.dbExplorer.newConnection.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editConnection",
        "title": "%command.dbExplorer.editConnection.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.copyConnection",
        "title": "%command.dbExplorer.copyConnection.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.deleteConnection",
        "title": "%command.dbExplorer.deleteConnection.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.refresh",
        "title": "%command.dbExplorer.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.refreshNode",
        "title": "%command.dbExplorer.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.viewDdl",
        "title": "%command.dbExplorer.viewDdl.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.createDatabase",
        "title": "%command.dbExplorer.createDatabase.title%",
        "icon": "$(add)",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.alterDatabase",
        "title": "%command.dbExplorer.alterDatabase.title%",
        "icon": "$(edit)",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.dropDatabase",
        "title": "%command.dbExplorer.dropDatabase.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.createTable",
        "title": "%command.dbExplorer.createTable.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.alterTable",
        "title": "%command.dbExplorer.alterTable.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.dropTable",
        "title": "%command.dbExplorer.dropTable.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.generateCode",
        "title": "%command.dbExplorer.generateCode.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.copyName",
        "title": "%command.dbExplorer.copyName.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.addColumn",
        "title": "%command.dbExplorer.addColumn.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editColumn",
        "title": "%command.dbExplorer.editColumn.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.dropColumn",
        "title": "%command.dbExplorer.dropColumn.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.copyQualifiedName",
        "title": "%command.dbExplorer.copyQualifiedName.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.generateSelect",
        "title": "%command.dbExplorer.generateSelect.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.openTable",
        "title": "%command.dbExplorer.openTable.title%",
        "category": "%command.category%",
        "icon": "$(link-external)"
      },
      {
        "command": "dbExplorer.queries.create",
        "title": "%command.dbExplorer.queries.create.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.queries.openDir",
        "title": "%command.dbExplorer.queries.openDir.title%",
        "category": "%command.category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dbExplorer.queries.delete",
        "title": "%command.dbExplorer.queries.delete.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.queries.rename",
        "title": "%command.dbExplorer.queries.rename.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.queries.open",
        "title": "%command.dbExplorer.queries.open.title%",
        "category": "%command.category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dbExplorer.executeQuery",
        "title": "%command.dbExplorer.executeQuery.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.executeQueryAt",
        "title": "%command.dbExplorer.executeQueryAt.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.executeQueryAll",
        "title": "%command.dbExplorer.executeQueryAll.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.consoleSelectConnection",
        "title": "%command.dbExplorer.consoleSelectConnection.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.queryHistory",
        "title": "%command.dbExplorer.queryHistory.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.disconnectConnection",
        "title": "%command.dbExplorer.disconnectConnection.title%",
        "category": "%command.category%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dbExplorer.saveQuery",
        "title": "%command.dbExplorer.saveQuery.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.openSavedQuery",
        "title": "%command.dbExplorer.openSavedQuery.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.formatSql",
        "title": "%command.dbExplorer.formatSql.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.showLog",
        "title": "%command.dbExplorer.showLog.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.showErDiagram",
        "title": "%command.dbExplorer.showErDiagram.title%",
        "category": "%command.category%",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "dbExplorer.erFocusTable",
        "title": "%command.dbExplorer.erFocusTable.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.settings",
        "title": "%command.dbExplorer.settings.title%",
        "category": "%command.category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dbExplorer.ai.settings",
        "title": "%command.dbExplorer.ai.settings.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.ai.generateSql",
        "title": "%command.dbExplorer.ai.generateSql.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.ai.explainSql",
        "title": "%command.dbExplorer.ai.explainSql.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.ai.fixErrorAt",
        "title": "%command.dbExplorer.ai.fixErrorAt.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.ai.acceptFix",
        "title": "%command.dbExplorer.ai.acceptFix.title%",
        "category": "%command.category%"
      },
      {
        "command": "dbExplorer.ai.discardFix",
        "title": "%command.dbExplorer.ai.discardFix.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dbExplorer.ai.explainSql",
          "when": "editorLangId == sql",
          "group": "dbkit@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dbExplorer.saveQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.formatSql",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.ai.generateSql",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.ai.explainSql",
          "when": "editorLangId == sql"
        }
      ],
      "view/title": [
        {
          "command": "dbExplorer.newConnection",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.settings",
          "group": "navigation@2"
        },
        {
          "command": "dbExplorer.refresh",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dbExplorer.openTable",
          "when": "viewItem =~ /^(table|view|collection)( ddl)?( er)?$/",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.openTable",
          "when": "viewItem =~ /^(table|view|collection)( ddl)?( er)?$/",
          "group": "1_open@0"
        },
        {
          "command": "dbExplorer.queries.create",
          "when": "viewItem =~ /^queries$/",
          "group": "2_object@6"
        },
        {
          "command": "dbExplorer.queries.create",
          "when": "viewItem =~ /^queries$/",
          "group": "inline@0"
        },
        {
          "command": "dbExplorer.queries.openDir",
          "when": "viewItem =~ /^queries$/",
          "group": "2_object@7"
        },
        {
          "command": "dbExplorer.queries.openDir",
          "when": "viewItem =~ /^queries$/",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.queries.rename",
          "when": "viewItem =~ /^query$/",
          "group": "2_object@0"
        },
        {
          "command": "dbExplorer.queries.delete",
          "when": "viewItem =~ /^query$/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.queries.delete",
          "when": "viewItem =~ /^query$/",
          "group": "inline@0"
        },
        {
          "command": "dbExplorer.copyConnection",
          "when": "viewItem =~ /^connection/",
          "group": "9_cutcopypaste"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "viewItem =~ /^connection/",
          "group": "3_manage@0"
        },
        {
          "command": "dbExplorer.deleteConnection",
          "when": "viewItem =~ /^connection/",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.disconnectConnection",
          "when": "viewItem =~ /^connection connected/",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.refreshNode",
          "when": "viewItem =~ /^connection connected/ || viewItem =~ /^database( ddl)?( dbddl)?( dbddl-alter)?( er)?$/",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.viewDdl",
          "when": "viewItem =~ /^(table|view)( ddl)?( er)?$/",
          "group": "2_object@1"
        },
        {
          "command": "dbExplorer.alterTable",
          "when": "viewItem =~ /^table ddl( er)?$/",
          "group": "2_object@5"
        },
        {
          "command": "dbExplorer.dropTable",
          "when": "viewItem =~ /^table ddl( er)?$/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.createDatabase",
          "when": "viewItem =~ /^connection connected dbddl$/",
          "group": "2_object@4"
        },
        {
          "command": "dbExplorer.alterDatabase",
          "when": "viewItem =~ /^database( ddl)?( dbddl)? dbddl-alter( er)?$/",
          "group": "2_object@4"
        },
        {
          "command": "dbExplorer.dropDatabase",
          "when": "viewItem =~ /^database( ddl)? dbddl/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.createTable",
          "when": "viewItem =~ /^database ddl( dbddl)?( dbddl-alter)?( er)?$/ || viewItem =~ /^folder-table ddl$/",
          "group": "2_object@5"
        },
        {
          "command": "dbExplorer.showErDiagram",
          "when": "viewItem =~ /^database( ddl)?( dbddl)?( dbddl-alter)? er$/",
          "group": "2_object@6"
        },
        {
          "command": "dbExplorer.erFocusTable",
          "when": "viewItem =~ /^table( ddl)? er$/",
          "group": "2_object@6"
        },
        {
          "command": "dbExplorer.generateCode",
          "when": "viewItem =~ /^(table|view)( ddl)?( er)?$/",
          "group": "2_object@4"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "viewItem =~ /^(table|view)( ddl)?( er)?$/ || viewItem == collection || viewItem == column || viewItem == index || viewItem == key",
          "group": "2_object@2"
        },
        {
          "command": "dbExplorer.generateSelect",
          "when": "viewItem =~ /^(table|view)( ddl)?( er)?$/",
          "group": "2_object@3"
        },
        {
          "command": "dbExplorer.addColumn",
          "when": "viewItem =~ /^folder-columns ddl$/ || viewItem =~ /^column ddl$/",
          "group": "2_object@5"
        },
        {
          "command": "dbExplorer.editColumn",
          "when": "viewItem =~ /^column ddl$/",
          "group": "2_object@6"
        },
        {
          "command": "dbExplorer.dropColumn",
          "when": "viewItem =~ /^column ddl$/",
          "group": "7_danger@0"
        },
        {
          "command": "dbExplorer.copyQualifiedName",
          "when": "viewItem =~ /^column( ddl)?$/",
          "group": "2_object@1"
        },
        {
          "command": "dbExplorer.refreshNode",
          "when": "viewItem =~ /^connection connected/",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.disconnectConnection",
          "when": "viewItem =~ /^connection connected/",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbExplorer.focus",
        "key": "ctrl+alt+d"
      },
      {
        "command": "dbExplorer.queryHistory",
        "key": "ctrl+alt+h"
      },
      {
        "command": "dbExplorer.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "dbExplorer.executeQueryAll",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "dbExplorer.ai.generateSql",
        "key": "alt+\\",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "DB Explorer",
      "properties": {
        "dbExplorer.query.maxRows": {
          "type": "number",
          "default": 1000,
          "description": "%config.dbExplorer.query.maxRows%"
        },
        "dbExplorer.query.timeoutMs": {
          "type": "number",
          "default": 15000,
          "description": "%config.dbExplorer.query.timeoutMs%"
        },
        "dbExplorer.connection.connectTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "%config.dbExplorer.connection.connectTimeoutMs%"
        },
        "dbExplorer.export.chunkRows": {
          "type": "number",
          "default": 1000,
          "description": "%config.dbExplorer.export.chunkRows%"
        },
        "dbExplorer.export.defaultFormat": {
          "type": "string",
          "default": "csv",
          "enum": [
            "csv",
            "json",
            "xlsx",
            "ndjson",
            "markdown",
            "insert"
          ],
          "enumDescriptions": [
            "%config.dbExplorer.export.format.csv%",
            "%config.dbExplorer.export.format.json%",
            "%config.dbExplorer.export.format.xlsx%",
            "%config.dbExplorer.export.format.ndjson%",
            "%config.dbExplorer.export.format.markdown%",
            "%config.dbExplorer.export.format.insert%"
          ],
          "description": "%config.dbExplorer.export.defaultFormat%"
        },
        "dbExplorer.queries.directory": {
          "type": "string",
          "default": "",
          "description": "%config.dbExplorer.queries.directory%"
        },
        "dbExplorer.transaction.idleTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "%config.dbExplorer.transaction.idleTimeoutMs%"
        },
        "dbExplorer.edit.allowNoPrimaryKey": {
          "type": "boolean",
          "default": false,
          "description": "%config.dbExplorer.edit.allowNoPrimaryKey%"
        },
        "dbExplorer.ai.endpoint": {
          "type": "string",
          "default": "",
          "description": "%config.dbExplorer.ai.endpoint%"
        },
        "dbExplorer.ai.model": {
          "type": "string",
          "default": "",
          "description": "%config.dbExplorer.ai.model%"
        },
        "dbExplorer.ai.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.dbExplorer.ai.temperature%"
        },
        "dbExplorer.ai.maxTokens": {
          "type": "integer",
          "default": 2048,
          "minimum": 1,
          "description": "%config.dbExplorer.ai.maxTokens%"
        }
      }
    }
  },
  "dependencies": {
    "@db-explorer/core": "workspace:*",
    "@db-explorer/driver-mock": "workspace:*",
    "@db-explorer/driver-mongo": "workspace:*",
    "@db-explorer/driver-mssql": "workspace:*",
    "@db-explorer/driver-mysql": "workspace:*",
    "@db-explorer/driver-oracle": "workspace:*",
    "@db-explorer/driver-postgres": "workspace:*",
    "@db-explorer/driver-redis": "workspace:*",
    "@db-explorer/driver-sqlite": "workspace:*",
    "@db-explorer/protocol": "workspace:*",
    "exceljs": "^4.4.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0"
  }
}
