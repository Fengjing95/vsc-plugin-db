node_modules/
dist/
out/
*.vsix
.eslintcache
coverage/
.vscode-test/
.DS_Store
# 树连接节点品牌 logo（esbuild 构建期从 webview-ui/src/assets/logos 拷贝的产物，不入库）
packages/extension/media/logos/
# sql.js wasm 引擎（M8-SQLite，esbuild 构建期从 driver-sqlite 依赖拷贝的产物，不入库）
packages/extension/media/sql-wasm.wasm
# 发布物随包文档副本（esbuild 构建期从仓库根拷贝，权威源在根目录，防双源漂移）
packages/extension/LICENSE
packages/extension/CHANGELOG.md
# 官网构建期素材拷贝产物（website/scripts/copy-assets.mjs 从 docs/images 等权威源生成，不入库防双源漂移）
website/public/assets/
# 官网 Playground 构建期产物（website/scripts/build-playground.mjs 从 packages/webview-ui/dist 生成，不入库）
website/public/playground/
# e2e 运行工件（M11-e2e：截图/临时 profile/runDir，runner 每轮生成，失败时保留供排查）
e2e/artifacts/
# e2e bridge 扩展产物（e2e/build.mjs 从 src/bridge 打包；package.json 是源，不入库防漂）
e2e/test-extension/extension.js
